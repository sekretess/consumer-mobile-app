# Uncomment this line to define a global platform for your project
platform :ios, '17.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# LibSignalClient does not build its Rust FFI from source here; its podspec
# downloads a prebuilt libsignal_ffi.a and verifies it against this sha256.
# Without it the build dies in the pod's download script with
# "LIBSIGNAL_FFI_PREBUILD_CHECKSUM: unbound variable".
#
# Signal publishes these checksums in Signal-iOS's own Podfile, but they skipped
# v0.86.5 (0.86.4 → 0.86.7), so this one was computed from the official archive
# at https://build-artifacts.signal.org/libraries/libsignal-client-ios-build-v0.86.5.tar.gz
# Keep it in sync with the tag pinned below — a stale pair fails the build loudly.
LIBSIGNAL_FFI_PREBUILD_CHECKSUM =
  'a3df979aa39b307ac4ef0f3fd59536daab5d6b3f8257c7aefe5f0470625f2582'

# The podspec picks this up on a fresh install (`ENV.fetch(..., '')`). It is not
# enough on its own: once the pod is downloaded, CocoaPods reuses the podspec
# cached in Pods/Local Podspecs, so the post_install hook below re-applies the
# value to the generated target on every install.
ENV['LIBSIGNAL_FFI_PREBUILD_CHECKSUM'] = LIBSIGNAL_FFI_PREBUILD_CHECKSUM

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  
  # Signal Protocol library
  # NOTE: LibSignalClient is installed via CocoaPods from GitHub
  pod 'LibSignalClient', git: 'https://github.com/signalapp/libsignal.git', tag: 'v0.86.5', testspecs: ["Tests"]

  
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # Fix Firebase Messaging non-modular header issue
    # Apply to all targets to ensure Firebase works correctly
    target.build_configurations.each do |config|
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      # Also set for Runner target
      if target.name == 'Runner' || target.name.include?('firebase') || target.name.include?('Firebase')
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
    
    # Fix LibSignalClient script phases if they fail
    if target.name == 'LibSignalClient'
      target.build_phases.each do |phase|
        if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
          # Ensure script phases have proper shell path
          phase.shell_path = '/bin/sh' unless phase.shell_path
        end
      end
      # Target build settings override the pod's xcconfig, so this wins even
      # when the cached podspec left the checksum empty.
      target.build_configurations.each do |config|
        config.build_settings['LIBSIGNAL_FFI_PREBUILD_CHECKSUM'] =
          LIBSIGNAL_FFI_PREBUILD_CHECKSUM
      end
    end
  end
  
  # Also apply to the main Runner project
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
  end
end
